# ===================== 编译中间产物 / 输出目录 =====================
# CDK(Keil 风格)工程的编译输出目录
Obj/
Lst/
__workspace_pack__/

# 编译器中间文件
*.o
*.obj
*.d
*.crf
*.dep
*.i
*.sbr
*.axf

# 链接与烧录输出
*.map
*.lst
*.hex
*.ihex

# 工程备份与临时文件
*.bak
*.tmp
*.swp
*~

# Windows 快捷方式（如 CP8003_REMOTER.cdkproj.lnk）
*.lnk

# ===================== CDK IDE 缓存与会话状态 =====================
.cache/
.cdk/

# ===================== 通用编译/打包输出 =====================
build/
output/
out/
